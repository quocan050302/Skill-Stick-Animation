{
  "name": "skill-stick-animation",
  "version": "0.1.0-short01",
  "private": true,
  "type": "module",
  "description": "Independent 2D-character + 3D-world, 9:16 vertical short video rendering project (SHORT-01 baseline)",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs --mode dev",
    "build": "tsc -p app/frontend/tsconfig.json --noEmit && node ./node_modules/vite/bin/vite.js build --config app/frontend/vite.config.ts",
    "start": "node tools/dev.mjs --mode start",
    "typecheck": "tsc -p app/frontend/tsconfig.json --noEmit",
    "setup:verify": "node tools/setup/safe_setup.mjs",
    "setup:restore": "node tools/setup/install_engine.mjs",
    "audit:kit": "python tools/setup/audit_kit.py",
    "smoke:webgl": "node tools/render/webgl_smoke.mjs",
    "render:original": "node tools/render/render_original.mjs",
    "render:parallel": "node tools/render/render_parallel.mjs",
    "test:node": "node --test tests/unit/test_contract_and_adapter.mjs tests/unit/test_original_kit_modules.mjs",
    "test:integration": "node --test tests/integration/test_short02_api.mjs",
    "test": "node --test tests/unit/test_contract_and_adapter.mjs tests/unit/test_original_kit_modules.mjs tests/unit/test_short02_backend.mjs tests/integration/test_short02_api.mjs",
    "test:e2e": "node tests/e2e/test_studio_e2e.mjs",
    "test:all": "python tests/run_all.py",
    "verify:all": "python tests/verify_all.py",
    "serve:api": "node app/server/api_server.mjs"
  },
  "dependencies": {
    "playwright": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
